# ==============================================================================
# Syllora Environment Configuration Template
# COPY THIS FILE TO .env.local AND FILL IN ACTUAL CREDENTIALS
# NEVER COMMIT .env.local OR REAL KEYS TO VERSION CONTROL
# ==============================================================================

# Client-Safe Supabase Configuration (Exposed to browser via Next.js NEXT_PUBLIC_ prefix)
# Used with Row Level Security (RLS) policies for anonymous & authenticated reads
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key-here

# Server-Side Only / Admin Secrets (NEVER prefix with NEXT_PUBLIC_ / NEVER expose to browser)
# Keep strictly on backend / serverless environment
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here